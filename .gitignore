node_modules/
.DS_Store
*.log
.env*

# python build artifacts (engine subprojects) — must never enter the plugin tree
__pycache__/
*.pyc
.pytest_cache/
.venv/

# machine-local wiring: resolved absolute paths, regenerated per-machine by /conclave:init
.claude/settings.json
.claude/settings.local.json

# transient agent run-state
**/agent-memory/gh-cache/
**/agent-memory/git-cache/
**/agent-memory/run-log/

# test pollution: env-less feedback tests resolve repo_root() to the repo root and
# write here. Real feedback data lives in DATA, at .conclave/ops/feedback/.
/ops/feedback/

# hired advisors are DATA (spec 103 §4): the real files live in .conclave/.claude/,
# and .claude/{agents,skills} hold per-item symlinks back to them.
.claude/agents/
.claude/skills/

# Obsidian rewrites workspace.json live (open files, pane layout). The vault template
# ships the three config files only — conclave_init.py:OBSIDIAN_FILES.
engine/templates/obsidian/workspace.json

# feature worktrees + SDD progress ledger/scratch
worktrees/
.superpowers/

# Conclave Self instance-state — tracked in its own git tree at .conclave/.git
.conclave/
